! user_nl_exo -- this case's planet, as settings for exoplanet_mod.F90.
!
! One `name = value` per line; `!` starts a comment; values are Fortran
! literals (.true., 1.0, 4.e3, 1.7e-6_r8, 'a/path'). Every parameter you can
! set is listed and documented in
!     $EXOCAM/cesm1.2.1/exoplanet/exoplanet_mod.F90.template
! Settings here override the config's defaults (configs/<config>/user_nl_exo).
! N2 fills to 1 bar automatically unless you set exo_n2bar.
!
! The values are compiled in. After editing, regenerate and rebuild:
!   $EXOCAM/cesm1.2.1/exoplanet/gen_exoplanet_mod.py <config> \
!       --user-nl user_nl_exo --out SourceMods/src.share/exoplanet_mod.F90
!   ./$CASE.build
!
! Example:
! exo_co2bar     = 0.01
! exo_scon       = 900.0
! exo_solar_file = '/path/to/ExoRT/data/solar/M3V_n68.nc'
